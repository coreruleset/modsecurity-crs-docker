#!/bin/sh

set -eu

# Configure the client certificate the proxy presents to the backend when the
# backend asks for one, to authenticate the proxy (mutual TLS).
#
# PROXY_SSL_CERT_FILE and PROXY_SSL_CERT_KEY_FILE point to the PEM-encoded
# certificate and private key. mod_ssl loads both from a single file configured
# with SSLProxyMachineCertificateFile, so both are combined into the generated
# file conf/proxy-client-cert.pem.
#
# Whether the client certificate is used at all is decided by
# check-proxy-client-cert, shared with the nginx images. mod_ssl fails to start
# if the referenced files do not exist, so this script only writes the include
# when a client certificate is configured: the default configuration starts
# without client certificates.

PREFIX="${1}"

MACHINE_CERT_FILE="${PREFIX}/conf/proxy-client-cert.pem"
MACHINE_CERT_CONFIG="${PREFIX}/conf/extra/httpd-proxy-client-cert.conf"

CERT_FILE="${PROXY_SSL_CERT_FILE:-}"
KEY_FILE="${PROXY_SSL_CERT_KEY_FILE:-}"

rm -f "${MACHINE_CERT_FILE}" "${MACHINE_CERT_CONFIG}"

rc=0
decision="$(check-proxy-client-cert "${PREFIX}/conf/proxy.crt" "${PREFIX}/conf/proxy.key")" || rc=$?
case "${decision:-}" in
    cert) ;;
    *) exit "${rc}" ;;
esac

umask 077
{ cat "${CERT_FILE}"; echo; cat "${KEY_FILE}"; echo; } > "${MACHINE_CERT_FILE}"

cat <<EOF > "${MACHINE_CERT_CONFIG}"
# Generated by update-proxy-ssl-config at start. The backend only asks for
# this certificate if it requests client authentication.
SSLProxyMachineCertificateFile "${MACHINE_CERT_FILE}"
EOF
