#!/bin/sh

set -eu

# Configure verification of TLS client certificates (mutual TLS) for incoming
# connections.
#
# SSL_VERIFY selects the mode (SSLVerifyClient): none (the default, no client
# certificate is requested), optional, require or optional_no_ca.
# SSL_CLIENT_CA_CERT_FILE points to the PEM-encoded CA certificates used to
# verify client certificates (SSLCACertificateFile) and is required unless the
# mode is optional_no_ca. SSL_CLIENT_CA_REVOCATION_FILE,
# SSL_CLIENT_CA_REVOCATION_CHECK and SSL_CLIENT_OCSP configure revocation
# checking; a configured revocation file always enables checking, with the
# mode defaulting to chain when SSL_CLIENT_CA_REVOCATION_CHECK is left at
# none.
#
# mod_ssl fails to start when a referenced file does not exist, so the file
# referencing directives are only written to the generated includes when the
# configured files are present; without an include the default configuration
# starts without client certificate verification.
#
# When SSL_VERIFY is none the script is a no-op: it does not write to the
# configuration directory, so it also works when that directory is read-only.

PREFIX="${1}"

CA_CONFIG="${PREFIX}/conf/extra/httpd-client-ca.conf"
HEADERS_CONFIG="${PREFIX}/conf/extra/httpd-client-headers.conf"

VERIFY="${SSL_VERIFY:-none}"

case "${VERIFY}" in
    none)
        echo "${0}: client certificate verification disabled"
        exit 0
        ;;
    optional|require|optional_no_ca)
        ;;
    *)
        echo "${0}: invalid SSL_VERIFY value, expected one of: none, optional, require, optional_no_ca" >&2
        exit 1
        ;;
esac

# The values shared with the nginx startup script are validated in one place.
check-ssl-client-verify-env

if [ "${SSL_ENGINE:-on}" = "off" ]; then
    echo "${0}: SSL_VERIFY=${VERIFY} requires SSL_ENGINE=on, refusing to start" >&2
    exit 1
fi

CA_FILE="${SSL_CLIENT_CA_CERT_FILE:-}"
REVOCATION_FILE="${SSL_CLIENT_CA_REVOCATION_FILE:-}"
REVOCATION_CHECK="${SSL_CLIENT_CA_REVOCATION_CHECK:-none}"
OCSP="${SSL_CLIENT_OCSP:-off}"
HEADER_PREFIX="${SSL_CLIENT_HEADER_PREFIX:-X-SSL-}"

case "${REVOCATION_CHECK}" in
    none|leaf|chain)
        ;;
    *)
        echo "${0}: invalid SSL_CLIENT_CA_REVOCATION_CHECK value, expected one of: none, leaf, chain" >&2
        exit 1
        ;;
esac

# A configured revocation file must not end up unused: with the check left at
# none mod_ssl does not look at the CRLs at all and accepts revoked
# certificates, so the check defaults to chain (all certificates in the chain)
# in that case.
if [ -n "${REVOCATION_FILE}" ] && [ "${REVOCATION_CHECK}" = "none" ]; then
    REVOCATION_CHECK="chain"
    echo "${0}: SSL_CLIENT_CA_REVOCATION_FILE is set, defaulting SSL_CLIENT_CA_REVOCATION_CHECK to chain"
fi

if [ "${REVOCATION_CHECK}" != "none" ] && [ -z "${REVOCATION_FILE}" ]; then
    echo "${0}: SSL_CLIENT_CA_REVOCATION_CHECK=${REVOCATION_CHECK} requires SSL_CLIENT_CA_REVOCATION_FILE, refusing to start" >&2
    exit 1
fi

case "${OCSP}" in
    off|on|leaf)
        ;;
    *)
        echo "${0}: invalid SSL_CLIENT_OCSP value, expected one of: off, on, leaf" >&2
        exit 1
        ;;
esac

# write_headers_config: write the generated include that forwards the client
# certificate identity to the backend. It only exists while client certificate
# verification is enabled, so client-supplied identity headers keep passing
# through untouched when it is not.
write_headers_config() {
    {
        echo "# Generated by update-ssl-client-verify-config at start. The"
        echo "# client certificate identity is only forwarded when the client"
        echo "# presented a certificate that verified successfully"
        echo "# (${HEADER_PREFIX}Client-Verify: SUCCESS): the claimed subject of"
        echo "# a certificate accepted without verification (optional_no_ca) is"
        echo "# not an identity. The verification result itself is forwarded"
        echo "# whenever a certificate was presented. Client-supplied"
        echo "# ${HEADER_PREFIX}Client-* headers are removed first so they cannot"
        echo "# be forged into the backend."
        echo "RequestHeader unset ${HEADER_PREFIX}Client-DN"
        echo "RequestHeader unset ${HEADER_PREFIX}Client-Verify"
        echo "RequestHeader set ${HEADER_PREFIX}Client-DN %{SSL_CLIENT_S_DN}s \"expr=%{SSL:SSL_CLIENT_VERIFY} == 'SUCCESS' && %{SSL:SSL_CLIENT_S_DN} != ''\""
        echo "RequestHeader set ${HEADER_PREFIX}Client-Verify %{SSL_CLIENT_VERIFY}s \"expr=%{SSL:SSL_CLIENT_VERIFY} != 'NONE' && %{SSL:SSL_CLIENT_VERIFY} != ''\""
    } > "${HEADERS_CONFIG}" || {
        echo "${0}: cannot write ${HEADERS_CONFIG}, refusing to start" >&2
        exit 1
    }
}

if [ -z "${CA_FILE}" ] || [ ! -r "${CA_FILE}" ]; then
    if [ "${VERIFY}" = "optional_no_ca" ]; then
        write_headers_config
        echo "${0}: accepting client certificates without verifying them (SSL_VERIFY=${VERIFY})"
        exit 0
    fi
    echo "${0}: SSL_VERIFY=${VERIFY} requires SSL_CLIENT_CA_CERT_FILE to name a readable file, refusing to start" >&2
    exit 1
fi

if [ -n "${REVOCATION_FILE}" ] && [ ! -r "${REVOCATION_FILE}" ]; then
    echo "${0}: SSL_CLIENT_CA_REVOCATION_FILE does not name a readable file, refusing to start" >&2
    exit 1
fi

write_headers_config

{
    echo "# Generated by update-ssl-client-verify-config at start. Client"
    echo "# certificates are verified against the CA below (SSLVerifyClient and"
    echo "# SSLVerifyDepth are set in httpd-vhosts.conf)."
    echo "SSLCACertificateFile \"${CA_FILE}\""
    if [ -n "${REVOCATION_FILE}" ]; then
        echo "SSLCARevocationFile \"${REVOCATION_FILE}\""
    fi
    if [ "${REVOCATION_CHECK}" != "none" ]; then
        echo "SSLCARevocationCheck ${REVOCATION_CHECK}"
    fi
    if [ "${OCSP}" != "off" ]; then
        echo "SSLOCSPEnable ${OCSP}"
    fi
} > "${CA_CONFIG}" || {
    echo "${0}: cannot write ${CA_CONFIG}, refusing to start" >&2
    exit 1
}

echo "${0}: verifying client certificates against ${CA_FILE}"
