#!/bin/sh
# vim:sw=2:ts=2:sts=2:et

# The port used in HTTP -> HTTPS redirects defaults to SSL_PORT. This file is
# sourced by the nginx entrypoint (not executed), before the templates are
# rendered, so exporting the value here makes ${SSL_REDIRECT_PORT} available to
# envsubst. Deployments that publish the TLS listener on a different external
# port (for example `-p 443:8443`) override it with SSL_REDIRECT_PORT.
SSL_REDIRECT_PORT="${SSL_REDIRECT_PORT:-${SSL_PORT:-8443}}"
export SSL_REDIRECT_PORT
