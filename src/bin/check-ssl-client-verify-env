#!/bin/sh

# Validate the environment variables shared by the Apache and nginx startup
# configuration for TLS client certificate verification (mutual TLS). The
# values end up in webserver configuration files, so reject the characters that
# could break out of the directive they are written to, or that are otherwise
# invalid.
#
# usage: check-ssl-client-verify-env [depth]
#
# With the "depth" argument only SSL_VERIFY_DEPTH is validated. It is
# substituted into the webserver configuration even when client certificate
# verification is disabled, so the startup scripts have to check it
# unconditionally. Without arguments all variables are validated; the calling
# startup script only does that when verification is enabled.

# check_config_value <name> <value>
check_config_value() {
    if printf '%s' "${2}" | LC_ALL=C grep -q -e '[";{}\\`$]' -e '[^ -~]'; then
        echo "${0}: ${1} contains unsupported characters, refusing to start" >&2
        exit 1
    fi
}

case "${SSL_VERIFY_DEPTH-1}" in
    '' | *[!0-9]*)
        echo "${0}: invalid SSL_VERIFY_DEPTH value, expected a number" >&2
        exit 1
        ;;
esac

if [ "${1:-}" = "depth" ]; then
    exit 0
fi

case "${SSL_CLIENT_HEADER_PREFIX-X-SSL-}" in
    '' | *[!A-Za-z0-9_-]*)
        echo "${0}: invalid SSL_CLIENT_HEADER_PREFIX value, expected HTTP header name characters (A-Z, a-z, 0-9, -, _)" >&2
        exit 1
        ;;
esac

check_config_value SSL_CLIENT_CA_CERT_FILE "${SSL_CLIENT_CA_CERT_FILE:-}"
check_config_value SSL_CLIENT_CA_REVOCATION_FILE "${SSL_CLIENT_CA_REVOCATION_FILE:-}"
